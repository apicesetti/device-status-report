# Firebase
FIREBASE_PROJECT_ID=device-status-report
# ID de la base de datos Firestore (default: "device-status-report"; usado en api_main.py como FIREBASE_DATABASE_ID)
FIREBASE_DATABASE_ID=device-status-report
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Autenticación
TOKENS_PATH=tokens.json

# API
PORT=8000
RESULTS_LIMIT=1000

# Rate Limiting (requests por minuto)
RATE_LIMIT_GET=60
RATE_LIMIT_POST=30

# Logging
LOG_LEVEL=INFO

# Tests (solo para test_api.py)
# Token válido para correr los tests contra la API (debe existir en tokens.json)
# API_TEST_TOKEN=sk-tu-token-real
# URL base de la API para los tests (default: http://localhost:8000)
# API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Launcher (scripts/backend_windows.py)
# Variables opcionales para sobreescribir los defaults del launcher.
# Por defecto el launcher no requiere ninguna de estas; los paths se resuelven
# automáticamente relativo a la carpeta del script.
# ---------------------------------------------------------------------------
# URL del repositorio a clonar/actualizar
# REPO_URL=https://github.com/apicesetti/device-status-report.git
#
# Carpeta donde se clona el repo (default: <carpeta_del_script>/device-status-report)
# REPO_PATH=C:\device-status-report
#
# Sub-carpeta del repo que contiene la API (default: API_REST)
# API_FOLDER=API_REST
#
# Comando Python a usar (default: python)
# PYTHON_CMD=python
#
# Override de ruta al firebase-key.json (default: busca junto al script)
# FIREBASE_CREDENTIALS_PATH=C:\ruta\a\firebase-key.json
#
# Override de ruta al tokens.json (default: busca junto al script)
# TOKENS_PATH=C:\ruta\a\tokens.json
