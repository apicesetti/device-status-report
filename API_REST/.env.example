# Firebase
FIREBASE_PROJECT_ID=device-status-report
# ID de la base de datos Firestore (default: "device-status-report"; usado en api_main.py como FIREBASE_DATABASE_ID)
FIREBASE_DATABASE_ID=device-status-report
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Autenticación
TOKENS_PATH=tokens.json

# API
PORT=8000
RESULTS_LIMIT=1000

# Rate Limiting (requests por minuto)
RATE_LIMIT_GET=60
RATE_LIMIT_POST=30

# Logging
LOG_LEVEL=INFO

# Tests (solo para test_api.py)
# Token válido para correr los tests contra la API (debe existir en tokens.json)
# API_TEST_TOKEN=sk-tu-token-real
# URL base de la API para los tests (default: http://localhost:8000)
# API_BASE_URL=http://localhost:8000
